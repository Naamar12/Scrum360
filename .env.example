# ANTHROPIC_API_KEY: Required for Claude AI API calls.
# Generate one at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- JIRA INTEGRATION ---
# Your Jira site domain (e.g., if your URL is https://mycompany.atlassian.net, the domain is 'mycompany')
JIRA_DOMAIN=""

# The email address associated with your Jira account
JIRA_EMAIL=""

# Your Jira API Token. Generate one at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=""

# The IDs of the Jira Boards you want to pull sprint data from, mapped to the Global Filter
JIRA_BOARD_ID_V1="1"
JIRA_BOARD_ID_MAKO3="2"
JIRA_BOARD_ID_N12="3"
JIRA_BOARD_ID_12_SCRUM="4"

# --- EAZYBI INTEGRATION (Velocity Trend) ---
# Your eazyBI account ID (visible in eazyBI URL: /accounts/{id}/...)
EAZYBI_ACCOUNT_ID=""

# eazyBI API token — generate in eazyBI → Account Settings → API
EAZYBI_API_TOKEN=""

# Report ID for "Committed vs Completed - Issue count" (from eazyBI → Dashboards → Team Sprint Reports)
EAZYBI_REPORT_ID_VELOCITY=""

# Team dimension names as they appear in eazyBI (must match exactly)
EAZYBI_TEAM_V1=""
EAZYBI_TEAM_MAKO=""
EAZYBI_TEAM_N12=""
EAZYBI_TEAM_12PLUS=""

# --- SLACK INTEGRATION ---
# Bot token for reading #deployed-versions channel (needs channels:history scope)
SLACK_BOT_TOKEN=""